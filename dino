<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dragon Runner Game</title>
    <style>
        body {
            margin: 0;
            overflow: hidden;
            background-color: #f7f7f7;
        }
        canvas {
            display: block;
            position: absolute;
            top: 0;
            left: 0;
        }
    </style>
</head>
<body>
    <canvas id="gameCanvas"></canvas>

    <script>
        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');

        // Set canvas size
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;

        // Game variables
        let dragonX = 50;
        let dragonY = canvas.height - 150;
        let gravity = 2;
        let jumpStrength = -20;
        let velocityY = 0;
        let obstacles = [];
        let isJumping = false;
        let gameSpeed = 6;
        let score = 0;

        // Load dragon image
        const dragonImg = new Image();
        dragonImg.src = 'dragon.png'; // Replace with your dragon sprite URL

        // Obstacle image
        const obstacleImg = new Image();
        obstacleImg.src = 'cactus.png'; // Replace with your obstacle sprite URL

        // Handle jumping
        document.addEventListener('keydown', (e) => {
            if (e.code === 'Space' && !isJumping) {
                velocityY = jumpStrength;
                isJumping = true;
            }
        });

        function spawnObstacle() {
            const obstacle = {
                x: canvas.width,
                y: canvas.height - 100,
                width: 50,
                height: 100
            };
            obstacles.push(obstacle);
        }

        function update() {
            // Clear canvas
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            // Dragon logic
            velocityY += gravity;
            dragonY += velocityY;
            if (dragonY >= canvas.height - 150) {
                dragonY = canvas.height - 150;
                isJumping = false;
            }

            // Draw dragon
            ctx.drawImage(dragonImg, dragonX, dragonY, 100, 100);

            // Obstacle logic
            if (Math.random() < 0.01) spawnObstacle();

            obstacles.forEach((obstacle, index) => {
                obstacle.x -= gameSpeed;
                ctx.drawImage(obstacleImg, obstacle.x, obstacle.y, obstacle.width, obstacle.height);

                // Collision detection
                if (
                    dragonX < obstacle.x + obstacle.width &&
                    dragonX + 100 > obstacle.x &&
                    dragonY < obstacle.y + obstacle.height &&
                    dragonY + 100 > obstacle.y
                ) {
                    // Game Over
                    alert('Game Over! Your Score: ' + score);
                    obstacles = [];
                    score = 0;
                }

                // Remove off-screen obstacles
                if (obstacle.x + obstacle.width < 0) {
                    obstacles.splice(index, 1);
                }
            });

            // Update score
            score++;
            ctx.font = '30px Arial';
            ctx.fillStyle = 'black';
            ctx.fillText('Score: ' + score, 10, 30);

            requestAnimationFrame(update);
        }

        // Start the game
        update();
    </script>
</body>
</html>
